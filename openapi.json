{
    "openapi": "3.1.2",
    "info": {
        "title": "yamo API",
        "version": "1.0.0",
        "description": "API de yamo, consomm\u00e9e par l'application mobile. Authentification par jeton Sanctum : `Authorization: Bearer <token>`."
    },
    "servers": [
        {
            "url": "https://yamo.ddev.site/api"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/v1/forms/{form}": {
            "get": {
                "operationId": "v1.forms.show",
                "summary": "D\u00e9finition d'un formulaire : champs (libell\u00e9s traduits), options, valeurs\npar d\u00e9faut, bouton d'envoi. Formulaire inconnu : 404 ; formulaire r\u00e9serv\u00e9\ndemand\u00e9 sans jeton : 401",
                "tags": [
                    "Form"
                ],
                "parameters": [
                    {
                        "name": "form",
                        "in": "path",
                        "required": true,
                        "description": "The form ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`FormResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/FormResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    }
                },
                "security": []
            }
        },
        "/v1/locales": {
            "get": {
                "operationId": "v1.locales.index",
                "summary": "Langues disponibles, chacune nomm\u00e9e dans sa propre langue. L'app mobile\nchoisit parmi elles la meilleure langue de l'appareil",
                "tags": [
                    "Locale"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "code": {
                                                        "type": "string"
                                                    },
                                                    "label": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "code",
                                                    "label"
                                                ]
                                            }
                                        },
                                        "default": {
                                            "type": "string",
                                            "description": "Langue par d\u00e9faut, quand aucune langue de l'appareil n'est disponible."
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "default"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/v1/auth/login": {
            "post": {
                "operationId": "v1.auth.login",
                "summary": "Connexion : renvoie l'utilisateur et un jeton \u00e0 envoyer ensuite en\n`Authorization: Bearer <token>`",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        },
                                        "token": {
                                            "type": "string",
                                            "description": "Jeton Sanctum de l'appareil."
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "token"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/logout": {
            "post": {
                "operationId": "v1.auth.logout",
                "summary": "D\u00e9connexion : r\u00e9voque le jeton utilis\u00e9 par la requ\u00eate",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/messages": {
            "get": {
                "operationId": "v1.messages.index",
                "summary": "Tous les textes de l'app, dans la langue du compte connect\u00e9, sinon celle de\n`Accept-Language`. Variables au format `:name`",
                "tags": [
                    "Message"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "locale": {
                                                    "type": "string",
                                                    "description": "Langue des textes renvoy\u00e9s."
                                                },
                                                "messages": {
                                                    "type": "object",
                                                    "description": "Textes par cl\u00e9 (`home.greeting`).",
                                                    "additionalProperties": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "required": [
                                                "locale",
                                                "messages"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/v1/auth/me/password": {
            "put": {
                "operationId": "v1.auth.me.password.update",
                "summary": "Changer son mot de passe. Les autres appareils sont d\u00e9connect\u00e9s ; celui-ci\nreste connect\u00e9",
                "tags": [
                    "Password"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdatePasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/me/personal-info": {
            "patch": {
                "operationId": "v1.auth.me.personal-info.update",
                "summary": "Modifier son pr\u00e9nom et son nom",
                "tags": [
                    "PersonalInfo"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdatePersonalInfoRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/me/preferences": {
            "patch": {
                "operationId": "v1.auth.me.preferences.update",
                "summary": "Modifier ses pr\u00e9f\u00e9rences (langue)",
                "tags": [
                    "Preferences"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdatePreferencesRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/me": {
            "get": {
                "operationId": "v1.auth.me",
                "summary": "Utilisateur connect\u00e9",
                "tags": [
                    "Profile"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/me/avatar": {
            "post": {
                "operationId": "v1.auth.me.avatar.update",
                "summary": "Remplacer sa photo de profil (multipart, champ `avatar` : JPEG, PNG ou WebP,\n5 Mo au plus). L'image est optimis\u00e9e avant d'\u00eatre enregistr\u00e9e",
                "tags": [
                    "Profile"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateAvatarRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "delete": {
                "operationId": "v1.auth.me.avatar.destroy",
                "summary": "Retirer sa photo de profil",
                "tags": [
                    "Profile"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "FormResource": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "title": {
                        "type": "null"
                    },
                    "subtitle": {
                        "type": "null"
                    },
                    "fields": {
                        "type": "array",
                        "items": {}
                    },
                    "submit": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "label"
                        ]
                    }
                },
                "required": [
                    "name",
                    "title",
                    "subtitle",
                    "fields",
                    "submit"
                ],
                "title": "FormResource"
            },
            "LoginRequest": {
                "type": "object",
                "description": "Connexion de l'application mobile. Les r\u00e8gles des champs saisis viennent du\nformulaire `auth.login` que l'app affiche ; `device_name`, renseign\u00e9 par l'app,\nnomme le jeton cr\u00e9\u00e9.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email",
                    "password",
                    "device_name"
                ],
                "title": "LoginRequest"
            },
            "UpdateAvatarRequest": {
                "type": "object",
                "description": "Envoi de sa propre photo de profil depuis l'app mobile (multipart, champ\n`avatar`). Les r\u00e8gles vivent dans `AvatarService`, partag\u00e9es avec le back-office.",
                "properties": {
                    "avatar": {
                        "type": "string",
                        "format": "binary",
                        "contentMediaType": "application/octet-stream",
                        "description": "Maximum file size: 5120 kilobytes."
                    }
                },
                "required": [
                    "avatar"
                ],
                "title": "UpdateAvatarRequest"
            },
            "UpdatePasswordRequest": {
                "type": "object",
                "description": "Changer son mot de passe. R\u00e8gles et libell\u00e9s : ceux du formulaire `PasswordForm`.",
                "properties": {
                    "current_password": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "password_confirmation": {
                        "type": "string"
                    }
                },
                "required": [
                    "current_password",
                    "password",
                    "password_confirmation"
                ],
                "title": "UpdatePasswordRequest"
            },
            "UpdatePersonalInfoRequest": {
                "type": "object",
                "description": "Modifier ses informations personnelles (pr\u00e9nom, nom). R\u00e8gles et libell\u00e9s : ceux du formulaire `PersonalInfoForm`.",
                "properties": {
                    "first_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "last_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "gender": {
                        "type": "string",
                        "enum": [
                            "male",
                            "female"
                        ]
                    },
                    "birth_date": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    }
                },
                "required": [
                    "first_name",
                    "last_name",
                    "gender"
                ],
                "title": "UpdatePersonalInfoRequest"
            },
            "UpdatePreferencesRequest": {
                "type": "object",
                "description": "Modifier ses pr\u00e9f\u00e9rences (langue). R\u00e8gles et libell\u00e9s : ceux du formulaire `PreferencesForm`.",
                "properties": {
                    "locale": {
                        "type": "string",
                        "enum": [
                            "fr",
                            "en"
                        ]
                    }
                },
                "required": [
                    "locale"
                ],
                "title": "UpdatePreferencesRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "full_name": {
                        "type": "string"
                    },
                    "initials": {
                        "type": "string"
                    },
                    "gender": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "male",
                            "female",
                            null
                        ]
                    },
                    "birth_date": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string"
                    },
                    "avatar_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "first_name",
                    "last_name",
                    "full_name",
                    "initials",
                    "gender",
                    "birth_date",
                    "email",
                    "locale",
                    "avatar_url"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AuthorizationException": {
                "description": "Authorization error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}